# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"

# ── Stripe embedded checkout ───────────────────────────────────────────────
# Public browser key: configure in Vercel Preview/Production as appropriate.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Server-side values: configure as Supabase Edge Function secrets, never expose
# these through NEXT_PUBLIC_* variables or commit real values to the repository.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Other payments (set as Supabase Edge Function secrets) ─────────────────
