{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@dokta/auth": ["./packages/auth/src/index.ts"],
      "@dokta/auth/*": ["./packages/auth/src/*"],
      "@dokta/ui": ["./packages/ui/src/index.ts"],
      "@dokta/ui/*": ["./packages/ui/src/*"],
      "@dokta/ui/tailwind-preset": ["./packages/ui/tailwind-preset.js"],
      "@dokta/ui/src/styles/globals.css": ["./packages/ui/src/styles/globals.css"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "supabase"]
}
